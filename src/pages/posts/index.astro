---
import PostCard from "@/components/PostCard.astro";
import Sidebar from "@/components/Sidebar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, getTags } from "@/lib/content";
const [posts, tags] = await Promise.all([getPosts(), getTags()]);
---
<BaseLayout title="全部文章" description="dailydreamer 的全部文章" canonicalPath="/posts/">
  <Sidebar posts={posts} tags={tags} />
  <main class="site-main">
    <section class="mx-auto max-w-5xl px-5 py-10 lg:px-10 lg:py-14">
      <h1 data-filter-heading class="text-4xl font-semibold text-ink">全部文章</h1>
      <p data-filter-count aria-live="polite" class="mt-3 text-muted">{posts.length} 篇文章</p>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  </main>
</BaseLayout>
