---
import { formatPostDate, getTagLabel, type Post } from "@/lib/content";
import { site } from "@/lib/site";

type Props = {
  posts: Post[];
  tags: Array<{ name: string; count: number }>;
  activeTag?: string;
  currentSlug?: string;
};

const { posts, tags, activeTag, currentSlug } = Astro.props;
---

<button
  id="sidebar-toggle"
  class="sidebar-toggle"
  type="button"
  aria-controls="site-sidebar"
  aria-expanded="true"
>
  <span class="sr-only">文章目录</span>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M15 6l-6 6 6 6" />
  </svg>
</button>

<aside id="site-sidebar" class="site-sidebar border-b border-line bg-white/92 lg:fixed lg:inset-y-0 lg:left-0 lg:w-88 lg:overflow-y-auto lg:border-b-0 lg:border-r">
  <div class="mx-auto flex max-w-6xl flex-col gap-7 px-5 py-6 lg:max-w-none lg:px-6 lg:py-8">
    <div class="sidebar-profile">
    <a href="/" class="sidebar-profile-link flex items-center gap-3">
      <img src={site.avatar} alt="dailydreamer avatar" class="size-12 rounded-full border border-line object-cover" />
      <div>
        <div class="text-lg font-semibold text-ink">dailydreamer</div>
        <div class="text-sm text-muted">技术、阅读、体验与远方</div>
      </div>
    </a>
    <button id="mobile-directory-close" class="sidebar-toggle" type="button" aria-label="收起文章目录" aria-controls="mobile-directory" aria-expanded="true">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
    </button>
    </div>

    <nav aria-label="Social links" class="social-links">
      <a href={site.github} target="_blank" rel="noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 .7a11.3 11.3 0 0 0-3.57 22.03c.57.1.78-.25.78-.55v-2.1c-3.16.68-3.83-1.35-3.83-1.35-.52-1.31-1.27-1.66-1.27-1.66-1.03-.71.08-.7.08-.7 1.14.08 1.74 1.18 1.74 1.18 1.02 1.73 2.67 1.23 3.32.94.1-.73.4-1.23.72-1.51-2.52-.29-5.17-1.26-5.17-5.6 0-1.24.44-2.25 1.17-3.04-.12-.29-.51-1.44.11-3 0 0 .96-.31 3.12 1.16a10.77 10.77 0 0 1 5.68 0c2.17-1.47 3.12-1.16 3.12-1.16.62 1.56.23 2.71.11 3 .73.79 1.17 1.8 1.17 3.04 0 4.35-2.65 5.31-5.18 5.59.41.35.77 1.04.77 2.1v3.11c0 .3.21.66.79.55A11.3 11.3 0 0 0 12 .7Z"
          />
        </svg>
      </a>
      <a href={site.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.45 20.45h-3.56v-5.58c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.68H9.34V8.98h3.42v1.57h.05a3.75 3.75 0 0 1 3.38-1.86c3.61 0 4.28 2.38 4.28 5.47v6.29h-.02ZM5.32 7.41a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.04H3.53V8.98H7.1v11.47ZM22.23 0H1.76C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.76 24h20.47c.97 0 1.77-.77 1.77-1.72V1.72C24 .77 23.2 0 22.23 0Z" />
        </svg>
      </a>
      <a href="/rss.xml" type="application/rss+xml" aria-label="RSS">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5.1 17.82a2.54 2.54 0 1 1 0 5.08 2.54 2.54 0 0 1 0-5.08ZM2.64 9.53c6.5 0 11.83 5.28 11.83 11.83h-3.56a8.28 8.28 0 0 0-8.27-8.27V9.53Zm0-8.43c11.16 0 20.26 9.1 20.26 20.26h-3.56c0-9.2-7.5-16.7-16.7-16.7V1.1Z" />
        </svg>
      </a>
    </nav>

    <nav aria-label="Tags" class="flex flex-wrap gap-2">
      <a
        href="/posts/"
        aria-current={Astro.url.pathname === "/posts/" ? "page" : undefined}
        class:list={[
          "rounded-full border px-3 py-1.5 text-sm transition",
          Astro.url.pathname === "/posts/" ? "border-mint bg-mint-soft text-ink" : "border-line text-muted hover:border-mint/50 hover:text-ink",
        ]}
      >
        全部 <span class="ml-1 text-xs">{posts.length}</span>
      </a>
      {
        tags.map((tag) => (
          <a
            href={`/tags/${encodeURIComponent(tag.name)}/`}
            class:list={[
              "rounded-full border px-3 py-1.5 text-sm transition",
              activeTag === tag.name
                ? "border-mint bg-mint-soft text-ink"
                : "border-line text-muted hover:border-mint/50 hover:text-ink",
            ]}
          >
            {getTagLabel(tag.name)} <span class="ml-1 text-xs">{tag.count}</span>
          </a>
        ))
      }
    </nav>

    <nav aria-label="文章目录" class="space-y-1">
      {
        posts.map((post) => (
          <a
            href={`/posts/${post.slug}/`}
            class:list={[
              "grid grid-cols-[1fr_auto] gap-3 rounded-md px-3 py-2.5 text-sm transition",
              currentSlug === post.slug ? "bg-amber-soft text-ink" : "text-muted hover:bg-paper hover:text-ink",
            ]}
          >
            <span class="min-w-0 truncate">{post.title}</span>
            <time datetime={post.date.toISOString()} class="shrink-0 text-xs text-muted">
              {formatPostDate(post.calendarDate)}
            </time>
          </a>
        ))
      }
    </nav>
  </div>
</aside>

<dialog id="mobile-directory" class="mobile-directory" aria-labelledby="mobile-directory-title">
  <h2 id="mobile-directory-title" class="sr-only">文章目录</h2>
  <div id="mobile-directory-content" class="mobile-directory-content"></div>
</dialog>

<script>
  const toggle = document.getElementById("sidebar-toggle")!;
  const sidebar = document.getElementById("site-sidebar")!;
  const dialog = document.getElementById("mobile-directory") as HTMLDialogElement;
  const content = document.getElementById("mobile-directory-content")!;
  const close = document.getElementById("mobile-directory-close")!;
  const mobile = matchMedia("(max-width: 1023px)");
  const origin = document.createComment("sidebar position");
  sidebar.before(origin);
  const storageKey = "dailydreamer-sidebar-collapsed";
  const navigationWindow = location.href === "about:srcdoc" ? window.parent : window;
  const directoryHistory = navigationWindow.history;
  const token = Math.random().toString(36).slice(2);
  let desktopCollapsed = false;
  let savedBodyStyle = "";
  let savedScroll = 0;
  let locked = false;
  let waitingForBack = false;
  let pendingLink: HTMLAnchorElement | null = null;
  try { desktopCollapsed = localStorage.getItem(storageKey) === "1"; } catch {}

  function setExpanded(expanded: boolean) {
    toggle.setAttribute("aria-expanded", String(expanded));
    toggle.setAttribute("aria-label", expanded ? "收起文章目录" : "展开文章目录");
  }

  function finishClose() {
    if (dialog.open) dialog.close();
    if (locked) {
      document.body.style.cssText = savedBodyStyle;
      window.scrollTo({ top: savedScroll, behavior: "instant" });
      locked = false;
    }
    if (mobile.matches) setExpanded(false);
  }

  function openMenu(pushHistory = true) {
    if (!mobile.matches || dialog.open || waitingForBack) return;
    savedScroll = window.scrollY;
    if (pushHistory) {
      try { directoryHistory.pushState({ ...directoryHistory.state, mobileDirectory: token }, ""); } catch {}
    }
    savedBodyStyle = document.body.style.cssText;
    document.body.style.position = "fixed";
    document.body.style.top = `-${savedScroll}px`;
    document.body.style.left = "0";
    document.body.style.right = "0";
    document.body.style.overflow = "hidden";
    locked = true;
    dialog.showModal();
    setExpanded(true);
    close.focus();
  }

  function closeMenu(link: HTMLAnchorElement | null = null) {
    finishClose();
    if (directoryHistory.state?.mobileDirectory === token) {
      pendingLink = link;
      waitingForBack = true;
      directoryHistory.back();
    } else if (link) {
      link.click();
    }
  }

  function syncViewport() {
    if (dialog.open) closeMenu();
    if (mobile.matches) {
      document.body.classList.remove("sidebar-collapsed");
      content.append(sidebar);
      toggle.setAttribute("aria-controls", "mobile-directory");
      toggle.setAttribute("aria-haspopup", "dialog");
      setExpanded(false);
    } else {
      origin.after(sidebar);
      document.body.classList.toggle("sidebar-collapsed", desktopCollapsed);
      toggle.setAttribute("aria-controls", "site-sidebar");
      toggle.removeAttribute("aria-haspopup");
      setExpanded(!desktopCollapsed);
    }
  }

  toggle.addEventListener("click", () => {
    if (mobile.matches) { openMenu(); return; }
    desktopCollapsed = !desktopCollapsed;
    document.body.classList.toggle("sidebar-collapsed", desktopCollapsed);
    setExpanded(!desktopCollapsed);
    try { localStorage.setItem(storageKey, desktopCollapsed ? "1" : "0"); } catch {}
  });
  dialog.addEventListener("keydown", (event) => {
    if (event.key !== "Tab") return;
    const focusable = Array.from(dialog.querySelectorAll<HTMLElement>("button, a[href]"));
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
  });
  close.addEventListener("click", () => closeMenu());
  dialog.addEventListener("cancel", (event) => { event.preventDefault(); closeMenu(); });
  dialog.addEventListener("click", (event) => {
    if (event.target !== dialog) return;
    const box = dialog.getBoundingClientRect();
    if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) closeMenu();
  });
  sidebar.addEventListener("click", (event) => {
    const link = (event.target as Element).closest("a");
    if (!mobile.matches || !dialog.open || !link) return;
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || link.target === "_blank") {
      closeMenu();
      return;
    }
    event.preventDefault();
    event.stopPropagation();
    closeMenu(link);
  });
  function onHistoryChange() {
    waitingForBack = false;
    if (directoryHistory.state?.mobileDirectory === token && mobile.matches) { openMenu(false); return; }
    finishClose();
    const link = pendingLink;
    pendingLink = null;
    if (link) link.click();
  }
  navigationWindow.addEventListener("popstate", onHistoryChange);
  window.addEventListener("pagehide", () => {
    finishClose();
    navigationWindow.removeEventListener("popstate", onHistoryChange);
  });
  window.addEventListener("pageshow", () => { navigationWindow.addEventListener("popstate", onHistoryChange); finishClose(); syncViewport(); });
  mobile.addEventListener("change", syncViewport);
  syncViewport();
</script>
