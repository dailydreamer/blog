---
import { formatPostDate, getTagLabel, type Post } from "@/lib/content";
import { site } from "@/lib/site";

type Props = {
  posts: Post[];
  tags: Array<{ name: string; count: number }>;
  activeTag?: string;
  currentSlug?: string;
};

const { posts, tags, activeTag, currentSlug } = Astro.props;
---

<button
  id="sidebar-toggle"
  class="sidebar-toggle"
  type="button"
  aria-controls="site-sidebar"
  aria-expanded="true"
>
  <span class="sr-only">切换左侧目录</span>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M15 6l-6 6 6 6" />
  </svg>
</button>

<aside id="site-sidebar" class="site-sidebar border-b border-line bg-white/92 lg:fixed lg:inset-y-0 lg:left-0 lg:w-88 lg:overflow-y-auto lg:border-b-0 lg:border-r">
  <div class="mx-auto flex max-w-6xl flex-col gap-7 px-5 py-6 lg:max-w-none lg:px-6 lg:py-8">
    <a href="/" class="flex items-center gap-3">
      <img src={site.avatar} alt="dailydreamer avatar" class="size-12 rounded-full border border-line object-cover" />
      <div>
        <div class="text-lg font-semibold text-ink">dailydreamer</div>
        <div class="text-sm text-muted">技术、阅读、体验与远方</div>
      </div>
    </a>

    <nav aria-label="Social links" class="social-links">
      <a href={site.github} target="_blank" rel="noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 .7a11.3 11.3 0 0 0-3.57 22.03c.57.1.78-.25.78-.55v-2.1c-3.16.68-3.83-1.35-3.83-1.35-.52-1.31-1.27-1.66-1.27-1.66-1.03-.71.08-.7.08-.7 1.14.08 1.74 1.18 1.74 1.18 1.02 1.73 2.67 1.23 3.32.94.1-.73.4-1.23.72-1.51-2.52-.29-5.17-1.26-5.17-5.6 0-1.24.44-2.25 1.17-3.04-.12-.29-.51-1.44.11-3 0 0 .96-.31 3.12 1.16a10.77 10.77 0 0 1 5.68 0c2.17-1.47 3.12-1.16 3.12-1.16.62 1.56.23 2.71.11 3 .73.79 1.17 1.8 1.17 3.04 0 4.35-2.65 5.31-5.18 5.59.41.35.77 1.04.77 2.1v3.11c0 .3.21.66.79.55A11.3 11.3 0 0 0 12 .7Z"
          />
        </svg>
      </a>
      <a href={site.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.45 20.45h-3.56v-5.58c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.68H9.34V8.98h3.42v1.57h.05a3.75 3.75 0 0 1 3.38-1.86c3.61 0 4.28 2.38 4.28 5.47v6.29h-.02ZM5.32 7.41a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.04H3.53V8.98H7.1v11.47ZM22.23 0H1.76C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.76 24h20.47c.97 0 1.77-.77 1.77-1.72V1.72C24 .77 23.2 0 22.23 0Z" />
        </svg>
      </a>
      <a href="/rss.xml" type="application/rss+xml" aria-label="RSS">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5.1 17.82a2.54 2.54 0 1 1 0 5.08 2.54 2.54 0 0 1 0-5.08ZM2.64 9.53c6.5 0 11.83 5.28 11.83 11.83h-3.56a8.28 8.28 0 0 0-8.27-8.27V9.53Zm0-8.43c11.16 0 20.26 9.1 20.26 20.26h-3.56c0-9.2-7.5-16.7-16.7-16.7V1.1Z" />
        </svg>
      </a>
    </nav>

    <nav aria-label="Tags" class="flex flex-wrap gap-2">
      <a
        href="/"
        class:list={[
          "rounded-full border px-3 py-1.5 text-sm transition",
          !activeTag ? "border-mint bg-mint-soft text-ink" : "border-line text-muted hover:border-mint/50 hover:text-ink",
        ]}
      >
        全部 <span class="ml-1 text-xs">{posts.length}</span>
      </a>
      {
        tags.map((tag) => (
          <a
            href={`/tags/${encodeURIComponent(tag.name)}/`}
            class:list={[
              "rounded-full border px-3 py-1.5 text-sm transition",
              activeTag === tag.name
                ? "border-mint bg-mint-soft text-ink"
                : "border-line text-muted hover:border-mint/50 hover:text-ink",
            ]}
          >
            {getTagLabel(tag.name)} <span class="ml-1 text-xs">{tag.count}</span>
          </a>
        ))
      }
    </nav>

    <nav aria-label="Posts" class="hidden space-y-1 lg:block">
      {
        posts.map((post) => (
          <a
            href={`/posts/${post.slug}/`}
            class:list={[
              "grid grid-cols-[1fr_auto] gap-3 rounded-md px-3 py-2.5 text-sm transition",
              currentSlug === post.slug ? "bg-amber-soft text-ink" : "text-muted hover:bg-paper hover:text-ink",
            ]}
          >
            <span class="min-w-0 truncate">{post.title}</span>
            <time datetime={post.date.toISOString()} class="shrink-0 text-xs text-muted">
              {formatPostDate(post.date)}
            </time>
          </a>
        ))
      }
    </nav>
  </div>
</aside>

<script>
  const sidebarToggle = document.getElementById("sidebar-toggle");
  const sidebarStorageKey = "dailydreamer-sidebar-collapsed";

  function setSidebarCollapsed(collapsed) {
    document.body.classList.toggle("sidebar-collapsed", collapsed);
    sidebarToggle?.setAttribute("aria-expanded", String(!collapsed));
    try {
      localStorage.setItem(sidebarStorageKey, collapsed ? "1" : "0");
    } catch {}
  }

  try {
    setSidebarCollapsed(localStorage.getItem(sidebarStorageKey) === "1");
  } catch {}

  sidebarToggle?.addEventListener("click", () => {
    setSidebarCollapsed(!document.body.classList.contains("sidebar-collapsed"));
  });
</script>
