---
import { formatPostDate, getTagLabel, type Post } from "@/lib/content";

type Props = {
  post: Post;
  hidden?: boolean;
};

const { post, hidden = false } = Astro.props;
---

<article data-post-tags={JSON.stringify(post.tags)} hidden={hidden} class="rounded-lg border border-line bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-mint/40 hover:shadow-md">
  <a href={`/posts/${post.slug}/`} class="group block">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
      <time datetime={post.date.toISOString()}>{formatPostDate(post.calendarDate)}</time>
      {post.tags.length > 0 && <span>{post.tags.map(getTagLabel).join(" / ")}</span>}
    </div>
    <h2 class="mt-3 text-xl font-semibold leading-snug text-ink group-hover:text-mint">
      {post.title}
    </h2>
    {post.excerpt && <p class="mt-3 line-clamp-3 text-[0.95rem] leading-7 text-muted">{post.excerpt}</p>}
  </a>
</article>
